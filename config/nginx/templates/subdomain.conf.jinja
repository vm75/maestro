{% import 'settings/proxy.jinja' as proxy with context %}
{% set proxy_upstream = '$subdomain_upstream' %}
{% set proxy_mount = '' %}
{% set fallback_prefix = 'rh_site' %}
server {
    server_name {{ server_name }};
    {% if _rh_listens is defined %}
    {{ _rh_listens }}
    include snippets/tls-policy.conf;
    {% else %}
    include snippets/ssl.conf;
    {% endif %}
    {% if _rh_check_ingress is defined %}if ($rh_wrong_ingress) { return 444; }{% endif %}
    {% if _rh_host_check is defined %}{{ _rh_host_check }}{% endif %}
    {% set frame_options = proxy.frame_options %}
    {% include 'snippets/security-headers.conf.jinja' %}
    include snippets/acme-challenge.conf;
    {% if _rh_access_checks is defined %}
    {{ _rh_access_checks }}
    {% elif proxy.lanonly %}
    include snippets/restrict.conf;
    {% endif %}
    {% include 'snippets/proxy-site.conf.jinja' %}
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Linux UI",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/linux-dev.sh", "build-ui"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Maestro",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--bin",
                "maestro",
                "--no-default-features",
                "--features",
                "linux-ui"
            ],
            "dependsOn": "Build Linux UI",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}

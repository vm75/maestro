{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Maestro: Linux mode",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin", "maestro", "--no-default-features", "--features", "linux-ui"],
                "filter": {
                    "name": "maestro",
                    "kind": "bin"
                }
            },
            "args": [
                "--config",
                "${workspaceFolder}/data/linux/maestro.yaml",
                "--linux-mode",
                "serve"
            ],
            "preLaunchTask": "Build Linux UI",
            "cwd": "${workspaceFolder}",
            "terminal": "integrated"
        }
    ]
}
